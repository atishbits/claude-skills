#!/usr/bin/env bash
# Invariant for this repo: it holds tools, never anyone's financial data.
#
# The skills here get symlinked into working folders that DO hold personal data
# -- broker exports, per-stock notes with quantities and cost, generated
# portfolio reports, tax paperwork -- and the scripts then run from inside this
# checkout. A stray `git add` is a realistic way for that to end up public. This
# hook blocks a commit whose staged files look like data rather than tooling.
#
# Prose leaks too: a lesson written up from a real run names a real holding, and
# a doc names the broker or platform its author uses. Two checks cover that:
#   - .private-terms, a gitignored file at the repo root, one term or extended
#     regex per line (# starts a comment). Anything staged that matches a line
#     of it, in content or in a path, blocks the commit. Matching ignores case.
#   - a percentage "of the book" / "of my portfolio" beside a ticker-like word.
#
# Install in a fresh clone:  git config core.hooksPath hooks
# Deliberate override:       git commit --no-verify
set -uo pipefail

fail=0
note() { echo "  ✗ $1"; fail=1; }

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

echo "pre-commit: checking staged files for personal data"

while IFS= read -r f; do
  base=$(basename "$f")
  low=$(printf '%s' "$f" | tr '[:upper:]' '[:lower:]')

  # Templates are the sanctioned way to ship a format: invented values only, and
  # named so the real thing (tax-profile.json, a holdings export) never matches.
  case "$base" in *-template.*) continue ;; esac

  # Generated from someone's book, whatever it is called.
  case "$low" in
    portfolio.md|*/portfolio.md|stocks/*.md|*/stocks/*.md|data/*|*/data/*)
      note "$f — generated from someone's holdings"; continue ;;
  esac

  # Source files are judged on their content further down, never on their name.
  # A skill *about* tax is legitimate tooling: skills/advance-tax/SKILL.md must
  # not trip a rule meant for a tax statement.
  case "$low" in
    *.md|*.py|*.sh|*.yml|*.yaml|*.toml|*.cfg|*.ini|*.txt) continue ;;
  esac

  case "$low" in
    *.xlsx|*.xls|*.ods|*.pdf|*.ofx|*.qif)
      note "$f — spreadsheets and statements do not belong in a tools repo"; continue ;;
  esac
  # Name checks use the basename: a path like skills/advance-tax/config.json is
  # a skill's own configuration, not a tax document.
  lowbase=$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]')
  case "$lowbase" in
    *holdings*|*broker*|*tradebook*|*contract?note*|*ledger*|*pnl*)
      note "$f — looks like a broker export"; continue ;;
  esac
  case "$lowbase" in
    *tax*|*itr*|*form16*|*form-16*|*26as*|*ais*|*capital?gain*|*profile*)
      note "$f — a data file named like tax paperwork or a personal profile"; continue ;;
  esac

  # Everything personal in this project arrives as a CSV, and the only CSV with
  # a reason to be here is the template skipped above. A genuine fixture can go
  # in with --no-verify, deliberately.
  case "$lowbase" in
    *.csv) note "$f — CSV files are data; only holdings-template.csv belongs here" ;;
  esac
done <<< "$staged"

# Content, checked against what is staged rather than the working tree. Lines
# that are plainly showing a format rather than a value are skipped, so a skill
# can document what a PAN looks like.
added=$(git diff --cached --unified=0 --diff-filter=ACMR | grep '^+' | grep -v '^+++' \
        | grep -viE 'example|placeholder|e\.g\.|format|xxxx|nnnn|<[a-z_ ]+>' || true)

scan() { # pattern, description
  if printf '%s' "$added" | grep -Eq "$1"; then
    note "staged content matches $2"
  fi
}

scan '\b[A-Z]{5}[0-9]{4}[A-Z]\b'            "a PAN number"
scan '\b[0-9]{4}[ -][0-9]{4}[ -][0-9]{4}\b' "an Aadhaar number"
scan '\bIN[0-9]{14}\b'                      "an NSDL demat ID"
scan '\b12[0-9]{14}\b'                      "a CDSL demat ID"
scan '\b[0-9]{9,18}\b.*(IFSC|ifsc)'         "bank account details"

# A broker export's header row, allowed only in the template handled above.
if printf '%s' "$added" | grep -qE '"?Instrument"?,\s*"?Qty\."?,\s*"?Avg\. cost'; then
  if ! printf '%s' "$staged" | grep -q -- '-template\.'; then
    note "staged content contains a broker export header row"
  fi
fi

# Private terms: the names this repo must never carry -- a broker, a platform,
# a bank, a ticker actually held. The list is itself private, so it lives in a
# gitignored file and the hook reports the line number that matched, never the
# term. Unlike the scans above, no line is exempt for looking like an example.
top=$(git rev-parse --show-toplevel)
terms_file="$top/.private-terms"
if printf '%s\n' "$staged" | grep -qx '\.private-terms'; then
  note ".private-terms — the list of private terms is itself private"
fi
if [ -f "$terms_file" ]; then
  while IFS= read -r f; do
    [ "$f" = ".private-terms" ] && continue
    text=$( { printf '%s\n' "$f"
              git diff --cached --unified=0 --diff-filter=ACMR -- "$f" \
                | grep '^+' | grep -v '^+++'; } || true )
    n=0
    while IFS= read -r term || [ -n "$term" ]; do
      n=$((n + 1))
      term=$(printf '%s' "$term" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
      case "$term" in ''|'#'*) continue ;; esac
      printf '%s\n' "$text" | grep -qiE -e "$term"
      case $? in
        0) note "$f — matches line $n of .private-terms" ;;
        1) ;;
        *) note ".private-terms line $n is not a valid extended regex" ;;
      esac
    done < "$terms_file"
  done <<< "$staged"
fi

# A weight beside a ticker reads like a real position: "STOCKA is 4% of the
# book". The window is an added line plus the one before it, since prose wraps.
# Placeholder tickers and the abbreviations a finance doc is full of are let
# through; write an example with those, or as a fraction ("a quarter of the book").
weights=$(git diff --cached --unified=0 --diff-filter=ACMR | awk '
  BEGIN {
    n = split("TICKER STOCKA STOCKB STOCKC BANKX BANKY EXAMPLEA EXAMPLEB EXAMPLEC IDEAA IDEAB " \
              "BUY HOLD SELL TRIM ENTER SKIP EXIT REVIEW LTCG STCG LTCL STCL ROE ROCE EPS PAT " \
              "PBT EBIT EBITDA CAGR YTM TDS DMA RSI PEG GARP NSE BSE SEBI ETF REIT NBFC PSU MNC " \
              "FII DII OFS RPT FCF CFO TTM YOY FMCG GST ITR PAN JSON CSV PDF URL API AND NOT THE", ok_list, " ")
    for (i = 1; i <= n; i++) ok[ok_list[i]] = 1
  }
  /^\+\+\+/ { prev = ""; next }
  !/^\+/ { next }
  {
    line = substr($0, 2); win = prev " " line; prev = line; low = tolower(win)
    if (low !~ /[0-9] ?% of (the |my |your )?(book|portfolio|holdings)/ &&
        low !~ /of my (book|portfolio|holdings)/) next
    m = split(win, w, /[^A-Z0-9&]+/)
    for (i = 1; i <= m; i++)
      if (length(w[i]) >= 3 && length(w[i]) <= 15 && w[i] ~ /^[A-Z][A-Z0-9&]+$/ && !(w[i] in ok)) {
        print line; break
      }
  }' || true)
if [ -n "$weights" ]; then
  note "staged content puts a portfolio weight beside a ticker-like word:"
  printf '%s\n' "$weights" | head -5 | sed 's/^/      /'
fi

if [ "$fail" -ne 0 ]; then
  cat <<'MSG'

Commit blocked: this repo must never contain personal financial data.

Unstage it:                      git restore --staged <file>
Genuine false positive:          git commit --no-verify

A skill that needs personal input should read it at runtime from the user's own
project folder, not carry a copy here.
MSG
  exit 1
fi

# Shared scripts have one master copy under shared/scripts/; each skill that
# uses one ships an identical copy so it works wherever it is installed. The
# copies are compared as staged (the index), not as they sit on disk.
copy_fail=0
while IFS= read -r cfg; do
  copy="$(dirname "$cfg")/drive_sync.py"
  if [ "$(git rev-parse -q --verify ":$copy" 2>/dev/null)" != \
       "$(git rev-parse -q --verify ":shared/scripts/drive_sync.py" 2>/dev/null)" ]; then
    echo "  ✗ $copy differs from shared/scripts/drive_sync.py, or is not staged"
    copy_fail=1
  fi
done < <(git ls-files ':(glob)skills/*/scripts/drive-sync.json')
if [ "$copy_fail" -ne 0 ]; then
  cat <<'MSG'

Commit blocked: a skill's copy of a shared script is out of step.

Edit only shared/scripts/drive_sync.py, then run shared/sync-copies.sh and stage
the copies it updates.
MSG
  exit 1
fi

# Every skill's scripts should be deterministic enough to unit test (see
# CLAUDE.md). If any .py file is staged, run every skill's own test suite and
# shared/scripts' suite -- not just the one touched, since a shared helper (fetch_fundamentals.py is
# imported by three_year_case.py and tax_lots.py) can break a sibling script
# without a change appearing in that script's own diff.
if printf '%s\n' "$staged" | grep -q '\.py$'; then
  echo "pre-commit: running unit tests"
  test_fail=0
  while IFS= read -r tests_dir; do
    skill_scripts=$(dirname "$tests_dir")
    if ! (cd "$skill_scripts" && python3 -m unittest discover -s tests -p 'test_*.py' >/tmp/pretest.$$ 2>&1); then
      echo "  ✗ $skill_scripts: tests failed"
      sed 's/^/      /' /tmp/pretest.$$
      test_fail=1
    fi
    rm -f /tmp/pretest.$$
  done < <(find skills shared -type d -name tests -path '*/scripts/tests')

  if [ "$test_fail" -ne 0 ]; then
    cat <<'MSG'

Commit blocked: a skill's unit tests are failing.

Fix the test or the code it covers, then re-stage and commit.
Deliberate override:       git commit --no-verify
MSG
    exit 1
  fi
  echo "pre-commit: tests pass"
fi

echo "pre-commit: clean"
exit 0
