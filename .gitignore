# A skill folder here may be symlinked into a working project, so the scripts
# run from inside this checkout. Keep what that produces out of git.
__pycache__/
*.pyc

# Anything a run writes: caches, snapshots, generated reports, broker exports.
data/
stocks/
PORTFOLIO.md
*holdings*.csv
!skills/*/holdings-template.csv

# Personal financial records have no reason to be here at all. Belt to the
# pre-commit hook's braces, since `git add -f` walks straight past a hook only
# when someone also passes --no-verify.
*.xlsx
*.xls
*.ods
*.pdf
*.ofx
*.qif
*zerodha*
*tradebook*
*ledger*.csv
*tax*
*itr*
*form16*
*26as*
